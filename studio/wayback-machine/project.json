{
  "schemaVersion": 1,
  "id": "9f458443-da82-4384-8d81-7b99fecefbce",
  "slug": "wayback-machine",
  "name": "Wayback Machine",
  "stage": "scaffold",
  "source": {
    "url": "https://web.archive.org/",
    "notes": "Trial run of the canopi-studio skill (no human in the loop; the agent made the choices at the stops). Goal: show readers whether the page they are on is archived, and let them cite archived copies.",
    "extracted": {
      "title": "Wayback Machine (Internet Archive)",
      "summary": "The Wayback Machine keeps more than two decades of captures of public web pages. Its Availability API answers, for any URL, whether an archived copy exists and which capture is closest to a given date; the CDX server lists every capture.",
      "audience": "Readers, researchers, journalists and Wikipedia editors who need to know whether a page has been archived, and to cite a copy that will not rot.",
      "entities": [
        {
          "name": "Snapshot",
          "description": "One capture of a URL at a moment in time.",
          "fields": [
            "url",
            "timestamp",
            "status",
            "available"
          ]
        },
        {
          "name": "Capture history",
          "description": "All captures of a URL, from the CDX server.",
          "fields": [
            "timestamp",
            "statuscode",
            "digest"
          ]
        }
      ],
      "pages": [
        {
          "urlPattern": "https://web.archive.org/web/<timestamp>/<url>",
          "purpose": "An archived snapshot of a page."
        },
        {
          "urlPattern": "https://web.archive.org/web/*/<url>",
          "purpose": "Calendar of every capture of a URL."
        }
      ],
      "apiHints": [
        {
          "evidence": "https://archive.org/help/wayback_api.php documents GET https://archive.org/wayback/available?url=<url>[&timestamp=YYYYMMDDhhmmss] and its response { url, archived_snapshots: { closest: { available, url, timestamp, status } } }, or { archived_snapshots: {} } when not archived.",
          "guess": "Latest and oldest snapshot of the page the reader is on, from pageUrl."
        },
        {
          "evidence": "Probed 2026-11-14: OPTIONS https://archive.org/wayback/available with Origin: null answered 200, access-control-allow-origin: null; GET answered access-control-allow-origin: * (and allow-credentials: true; no credentials are sent).",
          "guess": "A tablication can call it directly; going live is a config change."
        },
        {
          "evidence": "Seen live 2026-11-14: for a never-archived URL the API answered { archived_snapshots: {}, error: { code: \"timeout\", ... } } after ~5 s.",
          "guess": "Show an empty state, and expect slow answers for unknown URLs."
        },
        {
          "evidence": "The CDX server (https://web.archive.org/cdx/search/cdx?url=...&output=json) answers rows as arrays with a header row; OPTIONS with Origin: null answered 405.",
          "guess": "Captures per year would need a transform the sidebar kit cannot do (it binds objects); the shape used in the demo is invented."
        }
      ]
    }
  },
  "ideas": [
    {
      "id": "idea_1",
      "kind": "sidebar",
      "title": "Is this page archived?",
      "pitch": "Open the Wayback tab on any page and see straight away whether the Internet Archive has it: the latest capture, the first capture, and how often it has been saved over the years, each one link away.",
      "userStory": "As a researcher reading a page I may need to cite, I want to know whether a copy is safe in the Wayback Machine without leaving the page.",
      "whereItAppears": "Sidebar tab on every page; the page is looked up by its URL (pageUrl).",
      "triggers": [
        {
          "type": "page"
        }
      ],
      "dataNeeded": [
        "latest snapshot of the page",
        "oldest snapshot of the page",
        "captures per year"
      ],
      "selected": true
    },
    {
      "id": "idea_2",
      "kind": "smart-tag",
      "title": "Archived citation",
      "pitch": "Select a claim and attach the archived copy that backs it. Everyone who reads the page later sees the citation pill, and the evidence still opens when the original link has rotted.",
      "userStory": "As a Wikipedia editor or journalist, I want the archived source pinned to the sentence it supports so the record survives the original site.",
      "whereItAppears": "On a text selection of 20+ characters, or on a link the person chooses to tag.",
      "triggers": [
        {
          "type": "selection",
          "minChars": 20
        },
        {
          "type": "link"
        }
      ],
      "dataNeeded": [
        "archived snapshot URL",
        "original URL",
        "capture timestamp",
        "status of the original (live, changed, gone)",
        "why it matters"
      ],
      "selected": true
    },
    {
      "id": "idea_3",
      "kind": "both",
      "title": "Dead-link rescue",
      "pitch": "A pill on every dead link that points at its archived copy. Honest caveat: a tab cannot see the page's links and smart tags cannot check URLs, so this only works for links people tag by hand.",
      "userStory": "As a reader, I want a working copy when a link in an article is dead.",
      "whereItAppears": "On links (manual tagging only; automatic detection is not something the platform offers).",
      "triggers": [
        {
          "type": "link"
        }
      ],
      "dataNeeded": [
        "link target",
        "closest snapshot"
      ],
      "selected": false
    }
  ],
