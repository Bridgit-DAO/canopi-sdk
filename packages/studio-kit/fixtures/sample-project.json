    ],
    "notes": "Pinecone is a CRM for small B2B sales teams (5-50 reps). Reps live in the browser researching prospects; we want the account brief to follow them onto the prospect's own website.",
    "extracted": {
      "title": "Pinecone CRM: the lightweight CRM for small sales teams",
      "summary": "Pinecone tracks accounts, deals and activity for small B2B sales teams. It has a public REST API (accounts, deals, activities, reports) authenticated with per-workspace API keys, and a Chrome extension that today only logs emails.",
      "audience": "Account executives and sales managers at B2B companies with 5-50 reps.",
      "entities": [
        {
          "name": "Account",
          "description": "A company being sold to, keyed by its web domain.",
          "fields": [
            "id",
            "name",
            "domain",
            "industry",
            "owner",
            "tier",
            "arr",
            "health",
            "lastContactAt"
          ]
        },
        {
          "name": "Deal",
          "description": "An opportunity against an account, moving through pipeline stages.",
          "fields": [
            "id",
            "name",
            "stage",
            "amount",
            "closeDate",
            "probability"
          ]
        },
        {
          "name": "Activity",
          "description": "A logged email, call or meeting.",
          "fields": [
            "at",
            "type",
            "subject",
            "by"
          ]
        }
      ],
      "pages": [
        {
          "urlPattern": "https://app.pineconecrm.example/accounts/:id",
          "purpose": "Account record: owner, health, deals, timeline."
        },
        {
          "urlPattern": "https://app.pineconecrm.example/pipeline",
          "purpose": "Kanban board of open deals by stage."
        }
      ],
      "apiHints": [
        {
          "evidence": "developers.pineconecrm.example/reference#accounts-lookup documents GET /v1/accounts/lookup?domain=",
          "guess": "Look up the account for the site the rep is on by its hostname."
        },
        {
          "evidence": "OpenAPI link in the uploaded PDF lists /v1/deals and /v1/activities with an account_domain filter",
          "guess": "Deals and activity can be fetched by domain without a second lookup."
        },
        {
          "evidence": "No public reporting endpoint found",
          "guess": "Weekly pipeline totals would need a new /v1/reports/pipeline endpoint."
        }
      ]
    }
  },
  "ideas": [
    {
      "id": "idea_1",
      "kind": "sidebar",
      "title": "Account brief on the prospect's site",
      "pitch": "Open any prospect's website and the Pinecone tab shows who owns the account, open deals, the last touches and how the pipeline is trending.",
      "userStory": "As an account executive researching a prospect, I want their Pinecone record next to their website so I stop switching tabs before a call.",
      "whereItAppears": "Sidebar tab on every page; the account is matched by the page's hostname.",
      "triggers": [
        {
          "type": "page"
        }
      ],
      "dataNeeded": [
        "account by domain",
        "open deals for the account",
        "recent activity",
        "weekly pipeline totals"
      ],
      "selected": true
    },
    {
      "id": "idea_2",
      "kind": "smart-tag",
      "title": "Buying signals",
      "pitch": "Reps mark a passage on a news or careers page as a buying signal (funding, hiring, expansion) so the whole team sees it on that page.",
      "userStory": "As a sales manager, I want reps to flag buying signals where they find them so the evidence stays attached to the source.",
      "whereItAppears": "On a text selection of 20+ characters, and on news pages.",
      "triggers": [
        {
          "type": "selection",
          "minChars": 20
        },
        {
          "type": "url-pattern",
          "match": "*://*/news/*"
        }
      ],
      "dataNeeded": [
        "signal type",
        "why it matters",
        "strength 1-5",
        "source link"
      ],
      "selected": true
    },
    {
      "id": "idea_3",
      "kind": "both",
      "title": "Territory map",
      "pitch": "Show which rep owns each company you browse, with a pill on company names in articles.",
      "userStory": "As a rep, I want to know instantly whether a company mentioned in an article is in my territory.",
      "whereItAppears": "Company names in articles (needs entity detection the platform does not offer yet).",
      "triggers": [
        {
          "type": "manual"
        }
      ],
      "dataNeeded": [
        "territory assignments"
      ],
      "selected": false
    }
  ],
